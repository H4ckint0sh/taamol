<Layouts.app flash={@flash} current_scope={@current_scope} wide>
  <div id="start-page" class="overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <section class="grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-2 lg:gap-20 lg:py-32">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-base-300 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-base-content/65">
            <span class="size-2 rounded-full bg-primary"></span> {gettext("Welcome to Taamol")}
          </p>
          <h1 class="mt-7 max-w-xl text-5xl font-semibold leading-[1.08] tracking-tight sm:text-6xl">
            {gettext("A little more connection.")}
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-8 text-base-content/65">
            {gettext(
              "Welcome to your space on Taamol. Sign in to manage your account and stay connected."
            )}
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-4">
            <%= if @current_scope do %>
              <.link
                id="start-settings"
                href={~p"/users/settings"}
                class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3.5 text-sm font-semibold text-primary-content transition hover:opacity-85"
              >
                {gettext("Account settings")}
                <.icon name="hero-arrow-right" class="size-4 rtl:rotate-180" />
              </.link>
              <.link
                :if={Taamol.Accounts.allowed?(@current_scope, :view_dashboard)}
                id="start-dashboard"
                href={~p"/dashboard"}
                class="text-sm font-semibold hover:text-primary transition-colors"
              >{gettext("Go to dashboard")}
              <.icon name="hero-arrow-right" class="size-4 rtl:rotate-180" /></.link>
            <% else %>
              <.link
                id="start-register"
                href={~p"/users/register"}
                class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3.5 text-sm font-semibold text-primary-content transition hover:opacity-85"
              >
                {gettext("Create an account")}
                <.icon name="hero-arrow-right" class="size-4 rtl:rotate-180" />
              </.link>
              <.link
                id="start-login"
                href={~p"/users/log-in"}
                class="text-sm font-semibold hover:text-primary transition-colors"
              >
                {gettext("Already have an account? Log in")}
              </.link>
            <% end %>
          </div>
        </div>
        <div
          aria-hidden="true"
          class="relative min-h-80 overflow-hidden rounded-[2rem] bg-base-200 p-8 sm:min-h-96 sm:p-12"
        >
          <div class="absolute -right-20 -top-20 size-72 rounded-full bg-primary/20 blur-3xl">
          </div>
          <div class="absolute -bottom-28 -left-12 size-72 rounded-full bg-primary/15 blur-3xl">
          </div>
          <div class="relative flex h-full min-h-64 flex-col justify-between rounded-3xl border border-base-100/70 bg-base-100/75 p-7 shadow-xl backdrop-blur-sm sm:min-h-72">
            <div class="flex items-center justify-between">
              <span class="grid size-12 place-items-center rounded-2xl bg-primary text-xl font-bold text-primary-content">T</span>
              <span class="text-xs font-semibold uppercase tracking-[0.2em] text-base-content/50">Taamol</span>
            </div>
            <div>
              <p class="text-sm font-medium text-base-content/55">
                {gettext("A place to begin")}
              </p>
              <p class="mt-3 max-w-xs text-3xl font-semibold leading-tight tracking-tight">
                {gettext("Together starts here.")}
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layouts.app>
